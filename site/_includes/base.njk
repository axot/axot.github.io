<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{% if title %}{{ title }} — axot{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="axot">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/social.svg">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="preload" href="/assets/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="alternate" type="application/atom+xml" title="axot’s notebook" href="/atom.xml">
  <script src="/assets/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="axot home">axot<span class="wordmark-dot" aria-hidden="true"></span></a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/blog/archives/"{% if page.url == '/blog/archives/' or page.url == '/blog/' %} aria-current="page"{% endif %}>Writing</a>
      <a href="/#about">About</a>
      <a class="github-link" href="{{ site.github }}">GitHub <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme" hidden>
        <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.2 15.6A8.6 8.6 0 0 1 8.4 3.8 8.6 8.6 0 1 0 20.2 15.6Z"/></svg>
        <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="site-footer wrap">
    <p>© {{ year }} axot<span class="footer-note">. A notebook, not a news feed.</span></p>
    <nav aria-label="Elsewhere">
      <a href="{{ site.github }}">GitHub</a>
      <a href="{{ site.twitter }}">Twitter</a>
      <a href="/atom.xml">RSS</a>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </nav>
  </footer>
</body>
</html>
