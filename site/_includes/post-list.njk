<div class="post-list">
  {% for post in posts %}
  <article class="post-row" data-topic="{{ post.categorySlug }}">
    <div class="post-date"><time datetime="{{ post.isoDate }}">{{ post.displayDate }}</time><span>{{ post.topic }}</span></div>
    <div class="post-row-copy">
      <h3><a href="{{ post.url }}">{{ post.title }}</a></h3>
      <p>{{ post.summary }}</p>
    </div>
    <a class="post-open" href="{{ post.url }}" aria-label="Read {{ post.title }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
  </article>
  {% endfor %}
</div>
