---
permalink: /atom.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml | safe }}</title>
  <subtitle>{{ site.description | xml | safe }}</subtitle>
  <link href="{{ site.url }}/atom.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{{ posts[0].date.toISOString() }}</updated>
  <author><name>axot</name><uri>{{ site.github }}</uri></author>
  {% for post in posts %}
  <entry>
    <title>{{ post.originalTitle | xml | safe }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date.toISOString() }}</published>
    <updated>{{ post.date.toISOString() }}</updated>
    <summary>{{ post.summary | xml | safe }}</summary>
  </entry>
  {% endfor %}
</feed>
