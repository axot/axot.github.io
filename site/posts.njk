---
layout: base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "{{ post.url }}"
eleventyComputed:
  title: "{{ post.originalTitle }}"
  description: "{{ post.summary }}"
---
<article class="article-page wrap">
  <header class="article-header">
    <a class="text-link" href="/blog/archives/"><span aria-hidden="true">←</span> All writing</a>
    <div class="article-meta"><span>{{ post.topic }}</span><time datetime="{{ post.isoDate }}">{{ post.displayDate }}</time></div>
    <h1>{{ post.originalTitle }}</h1>
    <p class="article-deck">{{ post.summary }}</p>
  </header>
  <aside class="archive-notice"><strong>A note from the archive.</strong> This article was written in {{ post.year }}. Commands, software versions, downloads, and external links are historical references, not current recommendations.</aside>
  {% if post.languages.length %}
  <nav class="language-nav" aria-label="Article languages">{% for language in post.languages %}<a href="#{{ language.id }}" lang="{{ language.lang }}">{{ language.name }}</a>{% endfor %}</nav>
  {% endif %}
  <div class="prose">{{ post.html | safe }}</div>
  <footer class="article-footer"><a class="text-link" href="/blog/archives/">Back to the notebook <span aria-hidden="true">↗</span></a><a class="text-link" href="/atom.xml">Subscribe via RSS</a></footer>
</article>
